# Plik szablonowy zmiennych środowiskowych.
# Skopiuj do .env.local i uzupełnij brakujące klucze.
# NIGDY nie commituj .env.local ani .env — są w .gitignore.
# Klucze API pobierz z: Stripe Dashboard, Resend Dashboard, Cloudflare Dashboard, Google Cloud Console, Cookiebot Admin.

# === APLIKACJA ===
# (używana w TASK-10) Adres URL aplikacji frontendowej Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === WORDPRESS — DOCKER (TASK-03) ===
# (używana w TASK-03) Nazwa bazy danych dla kontenera MySQL
WP_DB_NAME=wordpress
# (używana w TASK-03) Użytkownik bazy danych WordPress
WP_DB_USER=wordpress
# (używana w TASK-03) Hasło bazy danych WordPress
WP_DB_PASSWORD=wordpress
# (używana w TASK-03) Host bazy danych w sieci Docker Compose
WP_DB_HOST=db
# (używana w TASK-03) Prefiks tabel w bazie danych WordPress
WP_TABLE_PREFIX=wp_

# === WORDPRESS — WPGRAPHQL (TASK-07, TASK-08) ===
# (używana w TASK-07) Adres URL endpointu WPGraphQL dla pobierania danych i mutacji
WORDPRESS_API_URL=http://localhost:8000/graphql
# (używana w TASK-08) Nazwa użytkownika WordPress dla Application Password (Basic Auth)
WP_APPLICATION_PASSWORD_USER=
# (używana w TASK-08) Application Password wygenerowane w panelu WP (Basic Auth)
WP_APPLICATION_PASSWORD=

# === ISR REVALIDATION (TASK-09) ===
# (używana w TASK-09) Sekret do weryfikacji żądań rewalidacji z WordPressa do Next.js (/api/revalidate)
REVALIDATE_SECRET=

# === RESEND (TASK-35) ===
# (używana w TASK-35) Klucz API serwisu Resend do wysyłki e-maili z powiadomieniami o leadach
RESEND_API_KEY=
# (używana w TASK-35) Adres e-mail nadawcy wiadomości
RESEND_FROM_EMAIL=noreply@example.com
# (używana w TASK-35) Adres e-mail odbiorcy formularza wyceny/kontaktu
RESEND_TO_EMAIL=biuro@example.com

# === STRIPE (TASK-36) ===
# (używana w TASK-36) Tajny klucz API Stripe do obsługi płatności
STRIPE_SECRET_KEY=
# (używana w TASK-36) Sekret webhooka Stripe do weryfikacji podpisów zdarzeń (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# (używana w TASK-36) Publiczny klucz API Stripe używany po stronie klienta
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === NEXTAUTH — LOGOWANIE KURSANTÓW (TASK-37a) ===
# (używana w TASK-37a) Tajny klucz do szyfrowania tokenów i sesji NextAuth
NEXTAUTH_SECRET=
# (używana w TASK-37a) Adres URL aplikacji dla NextAuth
NEXTAUTH_URL=http://localhost:3000
# (używana w TASK-37a) Host serwera SMTP Resend dla wysyłki magic linków
EMAIL_SERVER_HOST=smtp.resend.com
# (używana w TASK-37a) Port serwera SMTP
EMAIL_SERVER_PORT=465
# (używana w TASK-37a) Użytkownik serwera SMTP
EMAIL_SERVER_USER=resend
# (używana w TASK-37a) Hasło serwera SMTP (Resend API Key)
EMAIL_SERVER_PASSWORD=
# (używana w TASK-37a) Adres nadawcy wiadomości z magic linkiem
EMAIL_FROM=noreply@example.com

# === CLOUDFLARE STREAM — WIDEO LMS (TASK-38, DEC-02) ===
# (używana w TASK-38) ID konta Cloudflare do generowania podpisanych URL dla wideo
CLOUDFLARE_ACCOUNT_ID=
# (używana w TASK-38) Token API Cloudflare Stream z uprawnieniami do podpisywania URL
CLOUDFLARE_STREAM_API_TOKEN=

# === ANALYTICS I CMP (TASK-40) ===
# (używana w TASK-40) Identyfikator kontenera Google Tag Manager (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# (używana w TASK-40) Identyfikator strumienia danych Google Analytics 4 (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# (używana w TASK-40) ID grupy domen Cookiebot do zarządzania zgodami użytkowników (Consent Mode v2)
NEXT_PUBLIC_COOKIEBOT_DOMAIN_GROUP_ID=

# === GOOGLE MAPS EMBED ===
# (opcjonalna) Klucz API Google Maps Embed do wyświetlania interaktywnej mapy kontaktowej
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# === RECAPTCHA v3 (TASK-34) ===
# (używana w TASK-34) Klucz witryny Google ReCAPTCHA v3 po stronie klienta
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# (używana w TASK-34) Secret key Google ReCAPTCHA v3 po stronie serwera
RECAPTCHA_SECRET_KEY=
